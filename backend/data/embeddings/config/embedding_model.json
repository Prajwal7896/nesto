{
  "provider": "sentence-transformers",
  "model_name": "all-MiniLM-L6-v2",
  
  "embedding": {
    "dimension": 384,
    "normalize_embeddings": true
  },

  "device": {
    "type": "cpu",
    "use_mps_or_cuda_if_available": true
  },

  "performance": {
    "batch_size": 32,
    "max_seq_length": 256,
    "show_progress_bar": true
  },

  "cache": {
    "enable_cache": true,
    "cache_dir": "data/embeddings/embeddings_cache"
  },

  "fallback_models": [
    "all-mpnet-base-v2",
    "bge-small-en-v1.5"
  ]
}
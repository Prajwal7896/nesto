{
  "strategy": "jsonl_line_based",
  "description": "Each JSONL line is treated as one independent semantic chunk",
  
  "chunk_rules": {
    "type": "one_record_per_chunk",
    "max_tokens": 256,
    "min_tokens": 10,
    "merge_small_chunks": false
  },

  "fields": {
    "text_field": "text",
    "id_field": "id",
    "metadata_field": "metadata"
  },

  "preprocessing": {
    "clean_text": true,
    "lowercase": true,
    "remove_extra_spaces": true,
    "remove_special_chars": false,
    "remove_numbers": false
  },

  "splitting": {
    "method": "none",
    "sentence_split": false,
    "paragraph_split": false
  },

  "quality_control": {
    "drop_empty_chunks": true,
    "drop_duplicate_chunks": true,
    "min_unique_words": 5
  },

  "embedding_ready": true
}
{
  "category":"room_standards",
  "room":"living_room",
  "version":"2.0",
  "description":"Comprehensive living room planning standards for AI-driven residential and commercial floor planning. Covers dimensions, furniture layout, circulation, lighting, ventilation, acoustics, accessibility, electrical planning, entertainment setup, smart features and optimization.",

  "dimensions":{
    "minimum_area_sqft":140,
    "recommended_area_sqft":220,
    "luxury_area_sqft":400,
    "minimum_width_ft":12,
    "recommended_width_ft":16,
    "minimum_length_ft":12,
    "recommended_length_ft":18,
    "minimum_height_ft":10
  },

  "types":{
    "standard":{
      "recommended_area_sqft":180,
      "capacity":6
    },
    "family_lounge":{
      "recommended_area_sqft":220,
      "capacity":8
    },
    "formal_living":{
      "recommended_area_sqft":260,
      "capacity":10
    },
    "luxury_living":{
      "recommended_area_sqft":400,
      "capacity":16,
      "double_height_optional":true
    }
  },

  "location":{
    "preferred_orientation":[
      "North",
      "North-East",
      "East"
    ],
    "preferred_adjacent_rooms":[

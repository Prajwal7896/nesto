    "anti_skid":true,
    "easy_to_clean":true
  },

  "electrical":{
    "power_outlets":8,
    "tv_point":true,
    "internet_point":true,
    "speaker_points_optional":true,
    "smart_switches_supported":true,
    "usb_outlets_supported":true
  },

  "entertainment":{
    "tv_wall":true,
    "home_theater_optional":true,
    "projector_supported":true,
    "gaming_setup_optional":true
  },


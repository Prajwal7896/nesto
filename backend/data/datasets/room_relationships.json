      "from":"Entrance",
      "to":"Living Room",
      "maximum_steps":3
    },

    {
      "from":"Living Room",
      "to":"Kitchen",
      "maximum_steps":8
    },

    {
      "from":"Living Room",
      "to":"Bedrooms",
      "maximum_steps":12
    },

    {
      "from":"Parking",
      "to":"Kitchen",
      "maximum_steps":10
    }

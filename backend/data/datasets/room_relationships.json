      "priority":"mandatory",
      "weight":1.0
    },

    {
      "source":"Kitchen",
      "target":"Utility Room",
      "priority":"high",
      "weight":0.95
    },

    {
      "source":"Kitchen",
      "target":"Store Room",
      "priority":"medium",
      "weight":0.82
    },

    {
      "source":"Master Bedroom",
      "target":"Attached Bathroom",
      "priority":"mandatory",
      "weight":1.0
    },

    {
      "source":"Master Bedroom",
      "target":"Walk In Closet",
      "priority":"high",
      "weight":0.92

      "target":"Bathroom",
      "minimum_distance_ft":8,
      "severity":"critical"
    },

    {
      "source":"Dining Room",
      "target":"Bathroom",
      "minimum_distance_ft":8,
      "severity":"high"
    },

    {
      "source":"Master Bedroom",
      "target":"Main Entrance",
      "minimum_distance_ft":15,
      "severity":"medium"
    },

    {
      "source":"Pooja Room",
      "target":"Bathroom",
      "minimum_distance_ft":10,
      "severity":"high"
    },

    {
      "source":"Kitchen",
      "target":"Septic Tank",
      "minimum_distance_ft":12,
      "severity":"critical"
    }

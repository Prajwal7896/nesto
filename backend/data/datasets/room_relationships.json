      "room":"Master Bedroom",
      "privacy":"very_high"
    },

    {
      "room":"Bedroom",
      "privacy":"high"
    },

    {
      "room":"Guest Room",
      "privacy":"medium"
    },

    {
      "room":"Living Room",
